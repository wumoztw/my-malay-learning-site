---
import Base from '../layouts/Base.astro';
import Z from '../components/Z.astro';
import { vocab, cats } from '../data/vocab';
---
<Base title="第二關：常用馬來文單字、短句">
  <h1 class="text-3xl font-bold text-teal-800">第二關：常用馬來文單字、短句</h1>
  <p class="mt-2 text-slate-600">精選馬來西亞日常生活中最高頻的必備單字與生存短句（共 {vocab.length} 條），支援分類切換、注音即時輔助與點擊發音。點卡片翻面看使用情境。</p>
  <p class="mt-3 inline-block rounded-full bg-amber-100 px-4 py-1 text-sm font-semibold text-amber-800">🛫 旅遊通模式：收錄 {vocab.length}+ 條大馬自由行必備字句</p>
  <div class="mt-4 flex flex-wrap items-center gap-3">
    <div class="relative w-full sm:max-w-xl">
      <input id="vocab-search" type="search" autocomplete="off" placeholder="🔍 搜尋馬來文、中文、注音或情境（例如：makan、水、ㄇㄚ...）" aria-label="搜尋單字" class="w-full rounded-full border-2 border-teal-300 bg-white px-4 py-2 pr-10 text-base shadow-sm focus:border-teal-600 focus:outline-none" />
      <button type="button" id="search-clear" hidden aria-label="清除搜尋" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700">✕</button>
    </div>
    <span id="search-count" class="rounded-full bg-teal-100 px-3 py-1 text-sm font-semibold text-teal-800" aria-live="polite"></span>
  </div>
  <div id="filters" class="mt-4 flex flex-wrap gap-2">
    {['全部', ...cats].map((c) => <button type="button" data-cat={c} class="tile text-sm">{c}</button>)}
    <button type="button" data-cat="__fav" class="tile text-sm">⭐ 只看已收藏</button>
  </div>
  <p id="fav-empty" hidden class="mt-4 text-slate-500">目前還沒有收藏任何單字。點卡片右上角的 ☆ 即可加入收藏。</p>
  <div id="search-empty" hidden class="mt-4 rounded-xl bg-slate-100 p-4 text-slate-600">
    <span id="search-empty-text"></span>
    <button type="button" id="search-empty-clear" class="ml-2 rounded-full bg-teal-600 px-3 py-1 text-sm text-white">清除搜尋</button>
  </div>
  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {vocab.map((v) => (
      <div class="flip" data-cat={v.cat} data-search={`${v.ms} ${v.zy} ${v.zh} ${v.cat} ${v.note}`.toLowerCase()} role="button" tabindex="0" aria-label={`翻牌 ${v.ms}`}>
        <div class="flip-inner">
          <div class="face card relative flex flex-col items-center justify-center text-center">
            <button type="button" class="fav-star absolute right-2 top-2 text-lg text-slate-400" aria-label="收藏" data-id={v.ms} data-item={JSON.stringify({ id: v.ms, ms: v.ms, zy: v.zy, zh: v.zh, cat: v.cat, type: 'vocab' })}>☆</button>
            <span class="text-xs text-teal-600">{v.cat}</span>
            <span class="mt-2 text-3xl font-bold"><Z w={v.ms} z={v.zy} /></span>
            <span class="mt-2 text-lg">{v.zh}</span>
            <button type="button" class="speak mt-3 rounded-full bg-teal-600 px-3 py-1 text-sm text-white" data-say={v.ms}>🔊 發音</button>
            <span class="mt-2 text-xs text-slate-400">點擊翻面</span>
          </div>
          <div class="face back card bg-teal-50">
            <h3 class="font-bold">{v.ms} = {v.zh}</h3>
            <p class="mt-2 text-sm">💡 使用情境：{v.note}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
  <script>
    const cards = document.querySelectorAll<HTMLElement>('.flip');
    const empty = document.getElementById('fav-empty')!;
    const input = document.getElementById('vocab-search') as HTMLInputElement;
    const clearBtn = document.getElementById('search-clear')!;
    const countEl = document.getElementById('search-count')!;
    const searchEmpty = document.getElementById('search-empty')!;
    const searchEmptyText = document.getElementById('search-empty-text')!;
    let cat = '全部';
    const favs = () => (window as any).favStore;
    const apply = () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      cards.forEach((c) => {
        const id = c.querySelector<HTMLElement>('.fav-star')!.dataset.id!;
        const matchSearch = !q || (c.dataset.search ?? '').includes(q);
        const matchCat = cat === '全部' || (cat === '__fav' ? favs().has(id) : c.dataset.cat === cat);
        const ok = matchSearch && matchCat;
        c.style.display = ok ? '' : 'none';
        if (ok) shown++;
      });
      empty.hidden = !(cat === '__fav' && shown === 0 && !q);
      countEl.textContent = `顯示 ${shown} / ${cards.length} 筆結果`;
      clearBtn.hidden = !input.value;
      searchEmpty.hidden = !(q && shown === 0);
      searchEmptyText.textContent = `🔍 找不到符合「${input.value.trim()}」的字句，換個關鍵字或按全部試試！`;
    };
    const clearSearch = () => { input.value = ''; apply(); };
    input.addEventListener('input', apply);
    clearBtn.addEventListener('click', () => { clearSearch(); input.focus(); });
    document.getElementById('search-empty-clear')!.addEventListener('click', clearSearch);
    document.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      const typing = t === input || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) || t.isContentEditable;
      if ((e.key === '/' && !typing) || ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k')) {
        e.preventDefault(); input.focus(); input.select();
      } else if (e.key === 'Escape' && t === input) { clearSearch(); input.blur(); }
    });
    apply();
    cards.forEach((c) => {
      const toggle = () => c.classList.toggle('on');
      c.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('.speak, .fav-star')) toggle(); });
      c.addEventListener('keydown', (e) => { if (e.key === 'Enter' && e.target === c) toggle(); });
    });
    document.querySelectorAll<HTMLElement>('#filters button').forEach((btn) =>
      btn.addEventListener('click', () => { cat = btn.dataset.cat!; apply(); }),
    );
    window.addEventListener('fav_change', () => { if (cat === '__fav') apply(); });
  </script>
</Base>
