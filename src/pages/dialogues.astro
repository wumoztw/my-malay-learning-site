---
import Base from '../layouts/Base.astro';
import Sentence from '../components/Sentence.astro';
import { scenes } from '../data/dialogues';
---
<Base title="第四關：實戰情境會話館">
  <h1 class="text-3xl font-bold text-teal-800">第四關：實戰情境會話館</h1>
  <p class="mt-2 text-slate-600">每句可按 🔊 單句播放，單字上方為逐字注音。</p>
  <nav class="sticky top-0 z-10 -mx-1 mt-4 flex flex-wrap gap-2 bg-white/90 p-2 backdrop-blur" aria-label="情境快速導覽">
    {scenes.map((s) => (
      <a href={`#${s.id}`} data-jump={s.id} class="tile text-sm">{s.nav}</a>
    ))}
  </nav>
  {scenes.map((s) => (
    <section class="mt-8 scroll-mt-16" id={s.id}>
      <h2 class="text-xl font-bold">{s.title}</h2>
      <div class="mt-3 space-y-3">
        {s.lines.map((l) => {
          const text = l.ms.map((x) => x[0]).join(' ').replace(/ ([?.!])/g, '$1');
          const zy = l.ms.map((x) => x[1]).filter(Boolean).join(' ');
          const item = JSON.stringify({ id: text, ms: text, zy, zh: l.zh, cat: s.nav, type: 'dialogue' });
          return (
          <div class={`flex ${l.who === 'B' ? 'justify-end' : ''}`}>
            <div class={`max-w-[90%] rounded-2xl px-4 py-2 shadow-sm ${l.who === 'B' ? 'bg-teal-100' : 'bg-white'}`}>
              <div class="text-xs text-slate-500">{s.roles[l.who === 'A' ? 0 : 1]}</div>
              <Sentence words={l.ms} />
              <button type="button" class="fav-star ml-1 text-lg text-slate-400" aria-label="收藏此句" data-id={text} data-item={item}>☆</button>
              <div class="text-sm text-slate-600">{l.zh}</div>
            </div>
          </div>
          );
        })}
      </div>
    </section>
  ))}
  <script>
    document.querySelectorAll<HTMLAnchorElement>('[data-jump]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        document.getElementById(a.dataset.jump!)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  </script>
</Base>
