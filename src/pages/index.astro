---
import Base from '../layouts/Base.astro';
import Sentence from '../components/Sentence.astro';
const b = import.meta.env.BASE_URL;
const levels = [
  ['alphabet', '第一關', '26 字母注音速通館', '用注音掌握母音、子音與入聲煞車音。'],
  ['vocab', '第二關', '台語／生活同源詞認親館', '30+ 個你一秒就懂的單字。'],
  ['grammar', '第三關', '積木句型與倒裝挑戰', 'SVO 積木，名詞在前、形容詞在後。'],
  ['dialogues', '第四關', '實戰情境會話館', 'Mamak、搭車、夜市三大場景。'],
];
const daily: [string, string][] = [['Terima', 'ㄉㄜ ㄌㄧ ㄇㄚ'], ['kasih', 'ㄍㄚ ㄒㄧ']];
---
<Base title="首頁">
  <section class="text-center">
    <h1 class="text-3xl font-bold text-teal-800 sm:text-4xl">台灣人學馬來文，比你想的簡單</h1>
    <p class="mt-3 text-slate-600">用注音輔助、台語同源詞與積木句型，快速開口說 Bahasa Melayu。</p>
  </section>

  <section class="mt-8 grid gap-4 sm:grid-cols-3">
    <div class="card"><h2 class="font-bold">🌏 南島語系的根</h2><p class="mt-1 text-sm">台灣是南島語系的重要發源地之一，馬來語與台灣原住民語言同屬南島語族，數詞等基礎詞彙至今仍有相似之處。</p></div>
    <div class="card"><h2 class="font-bold">🎵 零聲調負擔</h2><p class="mt-1 text-sm">馬來文沒有聲調，不必再煩惱四聲，拼寫幾乎「看到就會念」。</p></div>
    <div class="card"><h2 class="font-bold">🧱 SVO 語序</h2><p class="mt-1 text-sm">主詞＋動詞＋受詞，和中文一樣！只有名詞與形容詞的順序要倒過來。</p></div>
  </section>

  <h2 class="mt-10 text-xl font-bold">四大關卡</h2>
  <p class="text-sm text-slate-500">建議依序學習：先發音 → 認親單字 → 組句 → 實戰對話。</p>
  <div class="mt-3 grid gap-4 sm:grid-cols-2">
    {levels.map(([p, n, t, d], i) => (
      <a href={`${b}${p}`} class="card block transition hover:border-teal-500 hover:shadow">
        <span class="text-xs font-bold text-teal-600">{n}（{i + 1}/4）</span>
        <h3 class="text-lg font-bold">{t}</h3><p class="text-sm text-slate-600">{d}</p>
      </a>
    ))}
  </div>

  <section class="card mt-10 bg-teal-50">
    <h2 class="text-sm font-bold text-teal-700">今日一句</h2>
    <p class="mt-2 text-2xl"><Sentence words={[...daily, ['!', '']]} /></p>
    <p class="mt-1">謝謝你。</p>
    <p class="mt-1 text-sm text-slate-600">🗣 台語彩蛋：terima kasih 字面是「接受（terima）愛（kasih）」；台語說「多謝 to-siā」，兩邊都有「心意」的味道，一起記更容易！</p>
  </section>
</Base>
